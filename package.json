{
  "name": "stellar-micropay-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "5.14.0",
    "@stellar/stellar-sdk": "12.3.0",
    "bullmq": "5.7.8",
    "express": "4.19.2",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.2",
    "@types/uuid": "9.0.8",
    "jest": "29.7.0",
    "prisma": "5.14.0",
    "ts-jest": "29.1.4",
    "supertest": "7.0.0",
    "@types/supertest": "6.0.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
